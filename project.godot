; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Veilbound"
config/description="A dark fantasy sword-fighting game. Break the veil. Claim the dawn."
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://art/icon.svg"

[autoload]

SaveManager="*res://scripts/save_manager.gd"
InputBootstrap="*res://scripts/input_bootstrap.gd"
AudioManager="*res://scripts/audio_manager.gd"

[display]

window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/size/min_width=768
window/size/min_height=432

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
